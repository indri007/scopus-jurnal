# Copy this to .streamlit/secrets.toml for local dev
# On Streamlit Community Cloud: add these via the Secrets UI

# ── Required ──────────────────────────────────────────
LLM_PROVIDER   = "openai"       # openai | deepseek | anthropic
OPENAI_API_KEY = "sk-..."
LLM_MODEL      = "gpt-4o"

# ── Optional ──────────────────────────────────────────
DEEPSEEK_API_KEY          = ""
ANTHROPIC_API_KEY         = ""
SEMANTIC_SCHOLAR_API_KEY  = ""
SCOPUS_API_KEY            = ""
GITHUB_TOKEN              = ""   # for private repos
