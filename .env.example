# ── LLM Provider ─────────────────────────────────────
# Options: openai | deepseek | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o

# ── Literature APIs ───────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
SCOPUS_API_KEY=

# ── Output ────────────────────────────────────────────
OUTPUT_FORMAT=both
CITATION_STYLE=apa
MAX_LITERATURE=20

# ── GitHub ────────────────────────────────────────────
GITHUB_TOKEN=
